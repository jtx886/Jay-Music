# Apache 环境下把 Authorization 头透传给 PHP，
# 否则 Bearer Token 可能被服务器吞掉。
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# 禁止直接访问 SQL 目录
<IfModule mod_rewrite.c>
    RewriteRule ^sql/ - [F,L]
</IfModule>
